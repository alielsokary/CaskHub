    "alert.quitDuringOperation" : {
      "comment" : "Quit confirmation body while a brew operation is running",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homebrew operation is still in progress. Quitting while Homebrew is working may leave the affected app in an incomplete state."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Операція Homebrew ще триває. Якщо завершити CaskHub під час роботи Homebrew, відповідна програма може залишитися в незавершеному стані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 操作仍在进行中。此时退出可能会让相关应用处于不完整状态。"
          }
        }
      }
    },
