            "value" : "Homebrew will adopt the existing %@ app without replacing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew adoptará la app %@ existente sin reemplazarla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew возьмёт существующее приложение %@ под управление, не заменяя его."
          }
        },
        "uk" : {
          "stringUnit" : {
