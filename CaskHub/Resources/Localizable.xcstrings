    "%@ has no casks. CaskHub shows casks only for now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene casks. Por ahora, CaskHub solo muestra casks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ нет cask-пакетов. Пока CaskHub показывает только их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ немає cask-пакетів. Поки що CaskHub показує лише їх."
          }
        },
        "zh-Hans" : {
