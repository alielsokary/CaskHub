  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@ casks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个 Cask"
          }
        }
      }
    },
    "%@ pours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 次下载"
          }
        }
      }
    },
    "%@ theme": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 主题"
          }
        }
      }
    },
    "%@ was installed using a package outside Homebrew. Adopting it will download and run Homebrew's package installer again, which may replace the existing application. After it finishes, Homebrew will manage the installation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是通过 Homebrew 之外的安装包安装的。接管它会重新下载并运行 Homebrew 的安装包，可能会替换现有应用。完成后将由 Homebrew 管理该安装。"
          }
        }
      }
    },
    "%@ was removed outside Homebrew, but Homebrew still has records for it. Clean Up removes the leftover data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在 Homebrew 之外被移除，但 Homebrew 仍保留着它的记录。「清理」会删除残留数据。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld Days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天"
          }
        }
      }
    },
    "%lld operations in progress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项操作进行中"
          }
        }
      }
    },
    "30 Days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天"
          }
        }
