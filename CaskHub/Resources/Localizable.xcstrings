    "alert.appManagementNeeded" : {
      "comment" : "Alert body asking for the App Management permission before adoption",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS only lets CaskHub modify other apps once you grant it the App Management permission, and adopting %@ may need to do that. Enable CaskHub under System Settings → Privacy & Security → App Management (a system notification may also offer it), then come back to continue the adoption."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS дозволяє CaskHub змінювати інші програми лише після надання дозволу «Керування програмами». Для додавання %@ під керування цей дозвіл може знадобитися. Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Керування програмами» (це також може запропонувати системне сповіщення), а потім поверніться, щоб продовжити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你授予「App 管理」权限后，macOS 才允许 CaskHub 修改其他应用，而接管 %@ 可能需要该权限。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub（系统通知也可能直接提供该选项），然后返回 CaskHub 继续接管。"
          }
        }
      }
    },
    "alert.homebrewMissing" : {
      "comment" : "Alert body when no Homebrew installation is detected",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub uses Homebrew to install and manage apps, and it doesn't seem to be installed on this Mac. Install it from brew.sh, then come back. CaskHub will pick it up automatically."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub використовує Homebrew для встановлення програм і керування ними, але Homebrew, схоже, не встановлено на цьому Mac. Встановіть його з brew.sh і поверніться — CaskHub виявить його автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub 依靠 Homebrew 来安装和管理应用，但这台 Mac 上似乎尚未安装。请从 brew.sh 安装后再回来，CaskHub 会自动识别。"
          }
        }
      }
    },
    "alert.installConflict.title" : {
      "comment" : "Alert title when an installed Homebrew cask conflicts with the requested cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't Install %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
