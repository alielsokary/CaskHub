    "alert.adopt.existingApplication" : {
      "comment" : "Alert body before adopting an existing app without replacing it",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew will adopt the existing %@ app without replacing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 将接管现有的 %@ 应用，而不会替换它。"
          }
        }
      }
    },
    "alert.adopt.packageInstaller" : {
      "comment" : "Alert body before adopting an app installed with a package installer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses a package installer, so Homebrew must run the installer again to create its management record. macOS may ask for an administrator password."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用使用软件包安装器，因此 Homebrew 必须再次运行安装器来创建管理记录。macOS 可能会要求输入管理员密码。"
          }
        }
      }
    },
    "alert.adopt.replaceApplication" : {
      "comment" : "Alert body before replacing an app bundle with the Homebrew version",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew will replace the current %@ app bundle with version %@, then manage future updates."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 将把当前的 %@ 应用替换为 %@ 版本，之后由 Homebrew 管理后续更新。"
          }
        }
      }
    },
    "alert.adopt.replacePackage" : {
      "comment" : "Alert body before replacing a package-installed app for adoption",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package installers cannot be adopted as metadata in this situation without reinstalling them. CaskHub will download the Homebrew package first, run the cask's forced uninstall steps, then install it. The app will be unavailable if the final installer fails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这种情况下，无法仅通过接管元数据来管理软件包安装器，必须重新安装。CaskHub 会先下载 Homebrew 软件包，运行 cask 的强制卸载步骤，然后进行安装。如果最终安装失败，该应用将不可用。"
          }
        }
      }
    },
    "alert.adopt.title" : {
      "comment" : "Alert title before adopting an app",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
