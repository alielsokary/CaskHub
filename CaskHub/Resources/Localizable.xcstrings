    "action.cleanup.zombieHelp" : {
      "comment" : "Tooltip on the Clean Up button for a zombie cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed outside Homebrew, but Homebrew still has records for it. Clean Up removes the leftover data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se eliminó fuera de Homebrew, pero Homebrew todavía conserva sus registros. Limpiar elimina los datos sobrantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ был удалён в обход Homebrew, но Homebrew всё ещё хранит записи о нём. «Очистить» удаляет оставшиеся данные."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було видалено поза Homebrew, але Homebrew досі зберігає записи про програму. «Очистити» видалить залишкові дані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Homebrew 之外被移除，但 Homebrew 仍保留着它的记录。「清理」会删除残留数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Homebrew 之外被移除，但 Homebrew 仍保留著它的記錄。「清理」會刪除殘留資料。"
          }
        }
      }
    },
    "Adjust text in app cards, lists, the sidebar, and the status bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el texto de las tarjetas de apps, las listas, la barra lateral y la barra de estado."
          }
        },
        "ru" : {
