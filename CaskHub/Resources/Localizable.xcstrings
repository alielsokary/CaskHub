    "action.cleanup.zombieHelp" : {
      "comment" : "Tooltip on the Clean Up button for a zombie cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed outside Homebrew, but Homebrew still has records for it. Clean Up removes the leftover data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було видалено поза Homebrew, але Homebrew досі зберігає записи про програму. «Очистити» видалить залишкові дані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Homebrew 之外被移除，但 Homebrew 仍保留着它的记录。「清理」会删除残留数据。"
          }
        }
      }
    },
