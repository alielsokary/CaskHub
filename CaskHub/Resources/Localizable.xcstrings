    "alert.quitDuringOperation" : {
      "comment" : "Quit confirmation body while a brew operation is running",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homebrew operation is still in progress. Quitting while Homebrew is working may leave the affected app in an incomplete state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía hay una operación de Homebrew en curso. Si sales mientras Homebrew está trabajando, la app afectada podría quedar en un estado incompleto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Операция Homebrew ещё выполняется. Выход во время работы Homebrew может оставить затронутое приложение в незавершённом состоянии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Операція Homebrew ще триває. Якщо завершити CaskHub під час роботи Homebrew, відповідна програма може залишитися в незавершеному стані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 操作仍在进行中。此时退出可能会让相关应用处于不完整状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 操作仍在進行中。此時退出可能會讓相關 App 處於不完整狀態。"
          }
        }
      }
    },
    "alert.uninstall.fullDiskAccess" : {
      "comment" : "Uninstall confirmation when app data cleanup is on but CaskHub lacks Full Disk Access",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing app data needs Full Disk Access, which CaskHub doesn't have. You can grant it in System Settings, or uninstall now and keep the app's data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para eliminar los datos de la app se necesita Acceso total al disco, y CaskHub no lo tiene. Puedes dárselo en Configuración del Sistema, o desinstalar ahora y conservar los datos de la app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для удаления данных приложения нужен полный доступ к диску, а у CaskHub его нет. Вы можете предоставить его в Системных настройках или удалить приложение сейчас, сохранив его данные."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для видалення даних програми потрібен повний доступ до диска, а CaskHub його не має. Ви можете надати його в Системних параметрах або видалити програму зараз, зберігши її дані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除应用数据需要完全磁盘访问权限，而 CaskHub 尚未获得该权限。你可以在系统设置中授予权限，或立即卸载并保留该应用的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 App 資料需要完全取用磁碟的權限，而 CaskHub 尚未取得該權限。你可以在系統設定中授予權限，或立即解除安裝並保留該 App 的資料。"
          }
        }
      }
    },
