    "Your installed copy doesn't match the version Homebrew has on record, so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已安装的版本与 Homebrew 记录的版本不一致，因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        }
      }
    },
    "Your installed copy of %@ is missing a component Homebrew's version includes (%@), so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your installed copy of %1$@ is missing a component Homebrew's version includes (%2$@), so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已安装的 %@ 缺少 Homebrew 版本包含的组件（%@），因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        }
      }
    },
    "`%@` failed (exit %d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "`%1$@` failed (exit %2$d)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` 执行失败（退出码 %d）。"
          }
        }
      }
    },
    "`%@` failed (exit %d): %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "`%1$@` failed (exit %2$d): %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` 执行失败（退出码 %d）：%@"
