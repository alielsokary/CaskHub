      }
    },
    "%@ comes from %@, not Homebrew. Installing makes Homebrew trust this cask and lets it run code on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene de %@, no de Homebrew. Al instalarla, Homebrew confiará en este cask y le permitirá ejecutar código en esta Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ поставляется из %2$@, а не из Homebrew. При установке Homebrew начнёт доверять этому cask, и он сможет выполнять код на этом Mac."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ надходить із %2$@, а не з Homebrew. Під час встановлення Homebrew почне довіряти цьому cask, і він зможе виконувати код на цьому Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 来自 %2$@，而非 Homebrew。安装后 Homebrew 将信任此 Cask，它可以在这台 Mac 上运行代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 來自 %2$@，而非 Homebrew。安裝後 Homebrew 將信任此 Cask，它可以在這台 Mac 上執行程式碼。"
          }
        }
      }
    },
