    "error.adoptMissingComponent" : {
      "comment" : "Error when adoption is blocked by a missing binary the cask ships",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your installed copy of %@ is missing a component Homebrew's version includes (%@), so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У встановленій копії %@ немає компонента з версії Homebrew (%@), тому її не можна додати під керування без змін. Натомість можна замінити її копією Homebrew — налаштування та дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安装的 %@ 缺少 Homebrew 版本包含的组件（%@），因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        }
      }
    },
    "error.adoptVersionMismatch" : {
      "comment" : "Error when adoption fails because installed version differs from the cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your installed copy doesn't match the version Homebrew has on record, so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлена копія не відповідає версії в записах Homebrew, тому її не можна додати під керування без змін. Натомість можна замінити її копією Homebrew — налаштування та дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安装的版本与 Homebrew 记录的版本不一致，因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        }
      }
    },
    "error.appManagementDenied" : {
      "comment" : "Error when the App Management permission blocks a brew operation",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blocked CaskHub from modifying apps on your Mac. Enable CaskHub under System Settings → Privacy & Security → App Management, then try again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS заборонила CaskHub змінювати програми на вашому Mac. Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Керування програмами» й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 阻止了 CaskHub 修改这台 Mac 上的应用。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub，然后重试。"
          }
        }
      }
    },
    "error.caskConflict" : {
      "comment" : "Error when a requested Homebrew cask conflicts with an installed Homebrew cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Homebrew cask “%@” conflicts with the installed cask “%@”. Uninstall “%@” before trying again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет Homebrew Cask «%@» конфліктує зі встановленим пакетом Cask «%@». Видаліть «%@» перед повторною спробою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew Cask“%@”与已安装的 Cask“%@”冲突。请先卸载“%@”，然后重试。"
          }
        }
      }
    },
    "error.caskConflictUnknown" : {
      "comment" : "Fallback error when Homebrew reports a cask conflict without naming the installed cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Homebrew cask conflicts with another installed cask. Uninstall the conflicting cask before trying again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пакет Homebrew Cask конфліктує з іншим установленим пакетом Cask. Видаліть конфліктний пакет перед повторною спробою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Homebrew Cask 与另一个已安装的 Cask 冲突。请先卸载冲突的 Cask，然后重试。"
          }
        }
      }
    },
    "error.checksumMismatch" : {
      "comment" : "Error when a cask download fails Homebrew's checksum verification",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download doesn't match the checksum Homebrew has on record — the developer likely replaced the release file after it was published. This isn't a problem with your Mac; Homebrew refuses mismatched downloads for security. Try again in a day or two once the cask is updated."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження не відповідає контрольній сумі в записах Homebrew — імовірно, розробник замінив файл випуску після публікації. Проблема не у вашому Mac: з міркувань безпеки Homebrew відхиляє завантаження з невідповідною контрольною сумою. Спробуйте знову через день або два, коли пакет Cask оновлять."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载内容与 Homebrew 记录的校验和不一致——开发者很可能在发布后替换了发行文件。这不是你的 Mac 的问题；出于安全考虑，Homebrew 会拒绝校验和不匹配的下载。请等该 Cask 更新后，过一两天再试。"
          }
        }
      }
    },
    "error.staleUpgradeRecord" : {
      "comment" : "Error when a stranded old app copy blocks every upgrade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A previous update left an old copy of the app inside Homebrew's records, and Homebrew refuses every upgrade until it's cleared. Repair removes the leftover copy and reinstalls the app fresh — your settings and data are kept."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереднє оновлення залишило стару копію програми в записах Homebrew, і Homebrew відхилятиме всі оновлення, доки її не буде видалено. Відновлення видалить залишкову копію та перевстановить програму — ваші налаштування й дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次更新在 Homebrew 的记录中残留了该应用的旧副本，在清除之前 Homebrew 会拒绝所有升级。「修复」会移除残留副本并重新全新安装——你的设置和数据会被保留。"
          }
        }
      }
    },
    "External application" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зовнішня програма"
          }
