    "settings.appManagement.description" : {
      "comment" : "Settings footnote explaining the App Management permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to adopt or update apps whose casks modify the app bundle (macOS otherwise blocks CaskHub from modifying other apps). Enable CaskHub under System Settings → Privacy & Security → App Management."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接管或更新那些会修改应用包的 Cask 时需要此权限（否则 macOS 会阻止 CaskHub 修改其他应用）。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub。"
          }
        }
      }
    },
    "settings.privacy.crashReports" : {
      "comment" : "Settings footnote for the crash reports toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends crash reports and technical diagnostics through Sentry to help identify and fix problems."
          }
        }
      }
    },
    "settings.privacy.usageAnalytics" : {
      "comment" : "Settings footnote for the usage analytics toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends anonymized usage signals through TelemetryDeck. No personal information is collected."
          }
        }
      }
    },
    "settings.storage.clearIconCache" : {
      "comment" : "Settings footnote under the Clear Cache button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes cached app icons. They re-download the next time each app is shown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除已缓存的应用图标。下次显示各应用时会重新下载。"
          }
        }
      }
    },
    "settings.updates.automaticChecks" : {
      "comment" : "Settings footnote for the automatic update checks toggle",
