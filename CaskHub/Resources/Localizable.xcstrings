            "value" : "Homebrew can't reinstall this app later. Uninstall it only if you no longer need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew no podrá reinstalar esta app más adelante. Desinstálala solo si ya no la necesitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew не сможет переустановить это приложение позже. Удаляйте его, только если оно вам больше не нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
