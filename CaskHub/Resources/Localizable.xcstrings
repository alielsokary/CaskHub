    "alert.adopt.packageInstaller" : {
      "comment" : "Alert body before adopting an app installed via pkg installer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was installed using a package outside Homebrew. Adopting it will download and run Homebrew's package installer again, which may replace the existing application. After it finishes, Homebrew will manage the installation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是通过 Homebrew 之外的安装包安装的。接管它会重新下载并运行 Homebrew 的安装包，可能会替换现有应用。完成后将由 Homebrew 管理该安装。"
          }
        }
      }
    },
    "alert.appManagementNeeded" : {
      "comment" : "Alert body asking for the App Management permission before adoption",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS only lets CaskHub modify other apps once you grant it the App Management permission, and adopting %@ may need to do that. Enable CaskHub under System Settings → Privacy & Security → App Management (a system notification may also offer it), then come back — the adoption will finish on its own."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你授予「App 管理」权限后，macOS 才允许 CaskHub 修改其他应用，而接管 %@ 可能需要该权限。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub（系统通知也可能直接提供该选项），然后回到这里——接管会自动完成。"
          }
        }
      }
    },
    "alert.homebrewMissing" : {
      "comment" : "Alert body when no Homebrew installation is detected",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub uses Homebrew to install and manage apps, and it doesn't seem to be installed on this Mac. Install it from brew.sh, then come back. CaskHub will pick it up automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub 依靠 Homebrew 来安装和管理应用，但这台 Mac 上似乎尚未安装。请从 brew.sh 安装后再回来，CaskHub 会自动识别。"
          }
        }
      }
    },
    "alert.quitDuringOperation" : {
      "comment" : "Quit confirmation body while a brew operation is running",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homebrew operation is still in progress. Quitting while Homebrew is working may leave the affected app in an incomplete state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 操作仍在进行中。此时退出可能会让相关应用处于不完整状态。"
          }
        }
      }
    },
    "alert.updateAll.confirmation" : {
      "comment" : "Confirmation body before updating every app on the Updates page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub will update all %lld apps currently listed on the Updates page using Homebrew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub 将使用 Homebrew 更新「更新」页面上当前列出的全部 %lld 个应用。"
          }
        }
      }
    },
