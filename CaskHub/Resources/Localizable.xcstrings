          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信任并从 %2$@ 安装 %1$@？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信任並從 %2$@ 安裝 %1$@？"
          }
        }
      }
    },
    "Use an https:// address. Unencrypted Git URLs aren't supported." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una dirección https://. No se admiten URL de Git sin cifrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте адрес https://. Незашифрованные адреса Git не поддерживаются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте адресу https://. Незашифровані адреси Git не підтримуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 https:// 地址。不支持未加密的 Git URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用 https:// 位址。不支援未加密的 Git URL。"
          }
        }
      }
    },
    "Use your fingerprint instead of your password when Homebrew needs administrator access. Your password is saved in the Keychain and removed when you turn this off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu huella digital en lugar de tu contraseña cuando Homebrew necesite acceso de administrador. Tu contraseña se guarda en el llavero y se elimina cuando desactivas esta opción."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте отпечаток пальца вместо пароля, когда Homebrew нужны права администратора. Пароль хранится в Связке ключей и удаляется при выключении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте відбиток пальця замість пароля, коли Homebrew потрібні права адміністратора. Пароль зберігається у Зв’язці ключів і видаляється після вимкнення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Homebrew 需要管理员权限时，使用指纹代替密码。密码存储在钥匙串中，关闭此选项后会被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Homebrew 需要管理者權限時，使用指紋代替密碼。密碼會儲存在鑰匙圈中，關閉此選項後會被移除。"
          }
        }
      }
    },
