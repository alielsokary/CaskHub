      }
    },
    "help.homebrew.install" : {
      "comment" : "Help: shown when no Homebrew installation is detected",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Homebrew from its official website, return to CaskHub, and the app will detect it automatically."
          }
        }
      }
    },
    "help.homebrew.subtitle" : {
      "comment" : "Help: Homebrew Setup page subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew is only required when CaskHub needs to install, update, adopt, repair, or uninstall an app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当 CaskHub 需要安装、更新、接管、修复或卸载应用时才需要 Homebrew。"
          }
        }
      }
    },
    "help.install.howTo" : {
      "comment" : "Help: Installing section body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Install on any catalog card. CaskHub shows live progress and lets you cancel downloads while Homebrew supports cancellation safely."
          }
        }
      }
    },
    "help.installAndUpdate.subtitle" : {
      "comment" : "Help: Install & Update page subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub runs operations through your real brew binary, so the same apps remain manageable from Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaskHub 通过本机的 brew 可执行文件执行操作，因此这些应用仍可在终端中管理。"
          }
        }
      }
    },
    "help.manage.overview" : {
      "comment" : "Help: Manage section body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install new apps, update Homebrew-managed apps, or adopt compatible apps already installed on your Mac."
          }
        }
      }
    },
    "help.permissions.grant" : {
      "comment" : "Help: how to grant App Management permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings → Privacy & Security → App Management, then enable CaskHub. Return to CaskHub afterward; a pending adoption can resume automatically."
          }
        }
      }
    },
    "help.permissions.subtitle" : {
      "comment" : "Help: App Management Permission page subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS may require permission before CaskHub can modify an application installed in /Applications."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 CaskHub 修改安装于 /Applications 的应用之前，macOS 可能要求授权。"
          }
        }
      }
    },
    "help.permissions.why" : {
      "comment" : "Help: why App Management permission is needed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some adoption and update operations need to replace or modify another app's bundle. macOS protects those changes with App Management permission."
          }
        }
      }
    },
    "help.troubleshooting.homebrewMissing" : {
      "comment" : "Help: troubleshooting Homebrew Not Found body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm Homebrew is installed. If it uses a custom prefix, select that location in Homebrew Settings."
          }
        }
      }
    },
    "help.troubleshooting.permissionDenied" : {
      "comment" : "Help: troubleshooting Permission Denied body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant App Management permission and retry. CaskHub only requests this when an operation may modify another app bundle."
          }
        }
      }
    },
    "help.troubleshooting.recovery" : {
      "comment" : "Help: troubleshooting Repair or Replace body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrupted or mismatched installations can expose Repair & Reinstall or Replace with Homebrew Version. These actions appear only when they match the detected failure."
          }
        }
      }
    },
    "help.troubleshooting.subtitle" : {
      "comment" : "Help: Troubleshooting page subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with the recovery action CaskHub presents for the affected app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先尝试 CaskHub 为受影响应用提供的恢复操作。"
          }
        }
      }
    },
    "help.updates.greedy" : {
      "comment" : "Help: Greedy Updates section body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Greedy to include casks that normally update themselves. Leave it off when you prefer each app's built-in updater."
          }
        }
      }
    },
    "help.updates.overview" : {
      "comment" : "Help: Updating section body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Updates page lists Homebrew-managed apps with meaningful updates. Update All asks for confirmation before starting the batch."
          }
        }
      }
    },
    "Homebrew" : {
      "shouldTranslate" : false
    },
    "Homebrew could not extract this disk image because its layout is read-only. Try again once; if it repeats, the cask needs to be corrected upstream." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 无法提取此磁盘映像，因为其布局为只读。请重试一次；如果问题再次出现，则需要由上游修正该 Cask。"
          }
