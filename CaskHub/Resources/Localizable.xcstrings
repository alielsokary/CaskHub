    "settings.appManagement.description" : {
      "comment" : "Settings footnote explaining the App Management permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to adopt or update apps whose casks modify the app bundle (macOS otherwise blocks CaskHub from modifying other apps). Enable CaskHub under System Settings → Privacy & Security → App Management."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para adoptar o actualizar apps cuyos casks modifican el paquete de la app (si no, macOS impide que CaskHub modifique otras apps). Activa CaskHub en Configuración del Sistema → Privacidad y seguridad → Gestión de apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется, чтобы брать под управление или обновлять приложения, чьи пакеты Cask изменяют пакет приложения (иначе macOS не разрешит CaskHub изменять другие приложения). Включите CaskHub в Системных настройках → Конфиденциальность и безопасность → Управление приложениями."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно для додавання під керування або оновлення програм, пакети Cask яких змінюють пакет програми (інакше macOS блокує зміни інших програм із CaskHub). Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Керування програмами»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接管或更新那些会修改应用包的 Cask 时需要此权限（否则 macOS 会阻止 CaskHub 修改其他应用）。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接管或更新那些會修改 App 套件的 Cask 時需要此權限（否則 macOS 會阻止 CaskHub 修改其他 App）。請在「系統設定 → 隱私權與安全性 → App 管理」中啟用 CaskHub。"
          }
        }
      }
    },
    "settings.fullDiskAccess.description" : {
      "comment" : "Settings footnote explaining the Full Disk Access permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed only to remove app data on uninstall. Without it, CaskHub uninstalls the app and keeps its data. Enable CaskHub under System Settings → Privacy & Security → Full Disk Access. Full Disk Access also covers App Management."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo es necesario para eliminar los datos de la app al desinstalarla. Sin este permiso, CaskHub desinstala la app y conserva sus datos. Activa CaskHub en Configuración del Sistema → Privacidad y seguridad → Acceso total al disco. Acceso total al disco también cubre Gestión de apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется только для удаления данных приложений при деинсталляции. Без него CaskHub удаляет приложение, но сохраняет его данные. Включите CaskHub в Системных настройках → Конфиденциальность и безопасность → Полный доступ к диску. Полный доступ к диску также включает управление приложениями."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно лише для видалення даних програм під час видалення. Без нього CaskHub видаляє програму, але зберігає її дані. Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Повний доступ до диска». Повний доступ до диска також охоплює керування програмами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在卸载时移除应用数据才需要此权限。没有此权限时，CaskHub 会卸载应用并保留其数据。请在「系统设置 → 隐私与安全性 → 完全磁盘访问权限」中启用 CaskHub。完全磁盘访问权限也包含 App 管理权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在解除安裝時移除 App 資料才需要此權限。沒有此權限時，CaskHub 會解除安裝 App 並保留其資料。請在「系統設定 → 隱私權與安全性 → 完全取用磁碟」中啟用 CaskHub。完全取用磁碟也包含 App 管理權限。"
          }
        }
      }
    },
    "settings.privacy.crashReports" : {
      "comment" : "Settings footnote for the crash reports toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends crash reports and technical diagnostics through Sentry to help identify and fix problems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía informes de fallos y diagnósticos técnicos a través de Sentry para ayudar a detectar y corregir problemas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет отчёты о сбоях и техническую диагностику через Sentry, чтобы помочь выявлять и устранять проблемы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає звіти про збої та технічну діагностику через Sentry, щоб допомогти виявити та усунути проблеми."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Sentry 傳送當機報告與技術診斷資料，協助找出並修正問題。"
          }
        }
      }
    },
    "settings.privacy.usageAnalytics" : {
      "comment" : "Settings footnote for the usage analytics toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends anonymous usage metrics through Sentry. TelemetryDeck receives only anonymous session and new-install signals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía métricas de uso anónimas a través de Sentry. TelemetryDeck solo recibe señales anónimas de sesión y de instalaciones nuevas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет анонимные метрики использования через Sentry. TelemetryDeck получает только анонимные сигналы о сеансах и новых установках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає анонімні показники використання через Sentry. TelemetryDeck отримує лише анонімні сигнали про сеанс і нове встановлення."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Sentry 傳送匿名使用資料。TelemetryDeck 只會收到匿名工作階段與新安裝訊號。"
          }
        }
      }
    },
    "settings.storage.clearIconCache" : {
