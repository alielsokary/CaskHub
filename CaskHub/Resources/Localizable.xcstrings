    "settings.appManagement.description" : {
      "comment" : "Settings footnote explaining the App Management permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to adopt or update apps whose casks modify the app bundle (macOS otherwise blocks CaskHub from modifying other apps). Enable CaskHub under System Settings → Privacy & Security → App Management."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно для додавання під керування або оновлення програм, пакети Cask яких змінюють пакет програми (інакше macOS блокує зміни інших програм із CaskHub). Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Керування програмами»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接管或更新那些会修改应用包的 Cask 时需要此权限（否则 macOS 会阻止 CaskHub 修改其他应用）。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub。"
          }
        }
      }
    },
    "settings.privacy.crashReports" : {
      "comment" : "Settings footnote for the crash reports toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends crash reports and technical diagnostics through Sentry to help identify and fix problems."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає звіти про збої та технічну діагностику через Sentry, щоб допомогти виявити та усунути проблеми."
          }
        }
      }
    },
    "settings.privacy.usageAnalytics" : {
      "comment" : "Settings footnote for the usage analytics toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends anonymous usage metrics through Sentry. TelemetryDeck receives only anonymous session and new-install signals."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає анонімні показники використання через Sentry. TelemetryDeck отримує лише анонімні сигнали про сеанс і нове встановлення."
          }
        }
      }
    },
    "settings.storage.clearIconCache" : {
      "comment" : "Settings footnote under the Clear Cache button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes cached app icons. They re-download the next time each app is shown."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє кешовані значки програм. Вони завантажаться знову під час наступного показу кожної програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除已缓存的应用图标。下次显示各应用时会重新下载。"
          }
        }
      }
    },
    "settings.updates.automaticChecks" : {
      "comment" : "Settings footnote for the automatic update checks toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When automatic checks are enabled, CaskHub downloads updates in the background and always shows the update prompt before installation."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли автоматичні перевірки ввімкнено, CaskHub завантажує оновлення у фоновому режимі та завжди показує запит на оновлення перед встановленням."
          }
        }
      }
    },
