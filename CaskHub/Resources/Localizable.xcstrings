    "The installed app was renamed, moved, or deleted since Homebrew installed it, which blocks the update. Force Update installs the new version and replaces any app already at its location. Your settings and data are kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app instalada se renombró, se movió o se eliminó después de que Homebrew la instalara, y eso bloquea la actualización. Forzar actualización instala la versión nueva y reemplaza cualquier app que ya esté en esa ubicación. Tu configuración y tus datos se conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленное приложение было переименовано, перемещено или удалено после установки через Homebrew, что блокирует обновление. «Принудительно обновить» устанавливает новую версию и заменяет приложение, которое уже находится на её месте. Ваши настройки и данные сохраняются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлений застосунок було перейменовано, переміщено або видалено після встановлення через Homebrew, що блокує оновлення. «Примусово оновити» встановлює нову версію та замінює застосунок, який уже є на її місці. Ваші налаштування та дані зберігаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的应用在 Homebrew 安装后被重命名、移动或删除，导致无法更新。“强制更新”会安装新版本，并替换该位置上已有的应用。你的设置和数据会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝的 App 在 Homebrew 安裝後被重新命名、移動或刪除，導致無法更新。「強制更新」會安裝新版本，並取代該位置上已有的 App。你的設定和資料會保留。"
          }
        }
      }
    },
    "The password could not be saved in the Keychain." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la contraseña en el llavero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить пароль в Связке ключей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти пароль у Зв’язці ключів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将密码存储在钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將密碼儲存在鑰匙圈中。"
          }
        }
      }
    },
    "This uninstalls everything installed from this tap:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desinstala todo lo que se instaló desde este tap:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалено всё, что установлено из этого тапа:"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде видалено все, що встановлено з цього тапу:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会卸载从此 Tap 安装的所有内容："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會解除安裝從此 Tap 安裝的所有內容："
          }
        }
      }
    },
    "Trust and install %@ from %@?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Confiar en %@ de %@ e instalarla?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверять и установить %1$@ из %2$@?"
          }
        },
        "uk" : {
          "stringUnit" : {
