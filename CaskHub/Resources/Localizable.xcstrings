    "error.adoptMissingComponent" : {
      "comment" : "Error when adoption is blocked by a missing binary the cask ships",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your installed copy of %@ is missing a component Homebrew's version includes (%@), so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu copia instalada de %@ le falta un componente que sí incluye la versión de Homebrew (%@), así que no se puede adoptar tal como está. En su lugar, puedes reemplazarla por la copia de Homebrew; tu configuración y tus datos se conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В установленной копии %@ отсутствует компонент, который есть в версии Homebrew (%@), поэтому взять её под управление как есть нельзя. Вместо этого можно заменить её копией Homebrew — настройки и данные сохранятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У встановленій копії %@ немає компонента з версії Homebrew (%@), тому її не можна додати під керування без змін. Натомість можна замінити її копією Homebrew — налаштування та дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安装的 %@ 缺少 Homebrew 版本包含的组件（%@），因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安裝的 %@ 缺少 Homebrew 版本包含的元件（%@），因此無法直接接管。你可以改為用 Homebrew 的版本替換它——你的設定和資料會被保留。"
          }
        }
      }
    },
    "error.adoptVersionMismatch" : {
      "comment" : "Error when adoption fails because installed version differs from the cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your installed copy doesn't match the version Homebrew has on record, so it can't be adopted as-is. You can replace it with Homebrew's copy instead — your settings and data are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu copia instalada no coincide con la versión que Homebrew tiene registrada, así que no se puede adoptar tal como está. En su lugar, puedes reemplazarla por la copia de Homebrew; tu configuración y tus datos se conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленная копия не совпадает с версией, которая числится у Homebrew, поэтому взять её под управление как есть нельзя. Вместо этого можно заменить её копией Homebrew — настройки и данные сохранятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлена копія не відповідає версії в записах Homebrew, тому її не можна додати під керування без змін. Натомість можна замінити її копією Homebrew — налаштування та дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安装的版本与 Homebrew 记录的版本不一致，因此无法直接接管。你可以改为用 Homebrew 的版本替换它——你的设置和数据会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已安裝的版本與 Homebrew 記錄的版本不一致，因此無法直接接管。你可以改為用 Homebrew 的版本替換它——你的設定和資料會被保留。"
          }
        }
      }
    },
    "error.appManagementDenied" : {
      "comment" : "Error when the App Management permission blocks a brew operation",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blocked CaskHub from modifying apps on your Mac. Enable CaskHub under System Settings → Privacy & Security → App Management, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS impidió que CaskHub modificara apps en tu Mac. Activa CaskHub en Configuración del Sistema → Privacidad y seguridad → Gestión de apps y vuelve a intentarlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не разрешает CaskHub изменять приложения на этом Mac. Включите CaskHub в Системных настройках → Конфиденциальность и безопасность → Управление приложениями и попробуйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS заборонила CaskHub змінювати програми на вашому Mac. Увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Керування програмами» й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 阻止了 CaskHub 修改这台 Mac 上的应用。请在「系统设置 → 隐私与安全性 → App 管理」中启用 CaskHub，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 阻止了 CaskHub 修改這台 Mac 上的 App。請在「系統設定 → 隱私權與安全性 → App 管理」中啟用 CaskHub，然後重試。"
          }
        }
      }
    },
    "error.caskConflict" : {
      "comment" : "Error when a requested Homebrew cask conflicts with an installed Homebrew cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Homebrew cask “%@” conflicts with the installed cask “%@”. Uninstall “%@” before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cask de Homebrew “%@” entra en conflicto con el cask instalado “%@”. Desinstala “%@” antes de volver a intentarlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет Cask «%@» конфликтует с установленным пакетом Cask «%@». Удалите «%@» перед повторной попыткой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет Homebrew Cask «%@» конфліктує зі встановленим пакетом Cask «%@». Видаліть «%@» перед повторною спробою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew Cask“%@”与已安装的 Cask“%@”冲突。请先卸载“%@”，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew Cask「%@」與已安裝的 Cask「%@」衝突。請先解除安裝「%@」，然後重試。"
          }
        }
      }
    },
    "error.caskConflictUnknown" : {
      "comment" : "Fallback error when Homebrew reports a cask conflict without naming the installed cask",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Homebrew cask conflicts with another installed cask. Uninstall the conflicting cask before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cask de Homebrew entra en conflicto con otro cask instalado. Desinstala el cask en conflicto antes de volver a intentarlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот пакет Cask конфликтует с другим установленным пакетом Cask. Удалите конфликтующий пакет перед повторной попыткой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пакет Homebrew Cask конфліктує з іншим установленим пакетом Cask. Видаліть конфліктний пакет перед повторною спробою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Homebrew Cask 与另一个已安装的 Cask 冲突。请先卸载冲突的 Cask，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Homebrew Cask 與另一個已安裝的 Cask 衝突。請先解除安裝衝突的 Cask，然後重試。"
          }
        }
      }
    },
    "error.checksumMismatch" : {
      "comment" : "Error when a cask download fails Homebrew's checksum verification",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download doesn't match the checksum Homebrew has on record — the developer likely replaced the release file after it was published. This isn't a problem with your Mac; Homebrew refuses mismatched downloads for security. Try again in a day or two once the cask is updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga no coincide con la suma de verificación que Homebrew tiene registrada; probablemente el desarrollador reemplazó el archivo después de publicarlo. No es un problema de tu Mac: Homebrew rechaza las descargas que no coinciden por seguridad. Vuelve a intentarlo en uno o dos días, cuando el cask se haya actualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка не совпадает с контрольной суммой, которая числится у Homebrew, — вероятно, разработчик заменил файл релиза после публикации. Это не проблема вашего Mac: Homebrew из соображений безопасности отклоняет несовпадающие загрузки. Повторите попытку через день-два, когда пакет Cask обновится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження не відповідає контрольній сумі в записах Homebrew — імовірно, розробник замінив файл випуску після публікації. Проблема не у вашому Mac: з міркувань безпеки Homebrew відхиляє завантаження з невідповідною контрольною сумою. Спробуйте знову через день або два, коли пакет Cask оновлять."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载内容与 Homebrew 记录的校验和不一致——开发者很可能在发布后替换了发行文件。这不是你的 Mac 的问题；出于安全考虑，Homebrew 会拒绝校验和不匹配的下载。请等该 Cask 更新后，过一两天再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載內容與 Homebrew 記錄的總和檢查碼不一致——開發者很可能在釋出後替換了發行檔案。這不是你的 Mac 的問題；出於安全考慮，Homebrew 會拒絕總和檢查碼不匹配的下載。請等該 Cask 更新後，過一兩天再試。"
          }
        }
      }
    },
    "error.fullDiskAccessRequired" : {
      "comment" : "Error when Homebrew cannot remove app data without Full Disk Access",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew couldn't remove this app's data because CaskHub doesn't have Full Disk Access. The app itself may already be removed. Force Uninstall finishes the uninstall and keeps the data. To remove data next time, enable CaskHub under System Settings → Privacy & Security → Full Disk Access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew no pudo eliminar los datos de esta app porque CaskHub no tiene Acceso total al disco. Es posible que la app ya se haya eliminado. Forzar desinstalación termina de desinstalarla y conserva los datos. Para eliminar los datos la próxima vez, activa CaskHub en Configuración del Sistema → Privacidad y seguridad → Acceso total al disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew не удалось удалить данные этого приложения, так как у CaskHub нет полного доступа к диску. Само приложение, возможно, уже удалено. «Force Uninstall» завершит удаление и сохранит данные. Чтобы в следующий раз удалять данные, включите CaskHub в Системных настройках → Конфиденциальность и безопасность → Полный доступ к диску."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew не вдалося видалити дані цієї програми, оскільки CaskHub не має повного доступу до диска. Саму програму, можливо, уже видалено. «Force Uninstall» завершить видалення та збереже дані. Щоб наступного разу видаляти дані, увімкніть CaskHub у меню «Системні параметри» → «Конфіденційність і безпека» → «Повний доступ до диска»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于 CaskHub 没有完全磁盘访问权限，Homebrew 无法移除该应用的数据。应用本身可能已被移除。「Force Uninstall」会完成卸载并保留数据。若要在下次移除数据，请在「系统设置 → 隐私与安全性 → 完全磁盘访问权限」中启用 CaskHub。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於 CaskHub 沒有完全取用磁碟的權限，Homebrew 無法移除該 App 的資料。App 本身可能已被移除。「Force Uninstall」會完成解除安裝並保留資料。若要在下次移除資料，請在「系統設定 → 隱私權與安全性 → 完全取用磁碟」中啟用 CaskHub。"
          }
        }
      }
    },
    "error.staleUpgradeRecord" : {
      "comment" : "Error when a stranded old app copy blocks every upgrade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A previous update left an old copy of the app inside Homebrew's records, and Homebrew refuses every upgrade until it's cleared. Repair removes the leftover copy and reinstalls the app fresh — your settings and data are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una actualización anterior dejó una copia vieja de la app en los registros de Homebrew, y Homebrew rechaza todas las actualizaciones hasta que se elimine. Reparar elimina esa copia sobrante y reinstala la app desde cero; tu configuración y tus datos se conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущее обновление оставило в записях Homebrew старую копию приложения, и Homebrew отклоняет любое обновление, пока она не будет удалена. «Восстановить» удаляет оставшуюся копию и переустанавливает приложение заново — настройки и данные сохранятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереднє оновлення залишило стару копію програми в записах Homebrew, і Homebrew відхилятиме всі оновлення, доки її не буде видалено. Відновлення видалить залишкову копію та перевстановить програму — ваші налаштування й дані буде збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次更新在 Homebrew 的记录中残留了该应用的旧副本，在清除之前 Homebrew 会拒绝所有升级。「修复」会移除残留副本并重新全新安装——你的设置和数据会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一次更新在 Homebrew 的記錄中殘留了該 App 的舊副本，在清除之前 Homebrew 會拒絕所有升級。「修復」會移除殘留副本並重新全新安裝——你的設定和資料會被保留。"
          }
        }
      }
    },
    "error.strandedUninstall" : {
      "comment" : "Error when a stranded app copy blocks an uninstall",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earlier operation stopped partway and left a copy of the app inside Homebrew's records, so Homebrew can't uninstall it. Force Uninstall clears the leftover copy and completes the uninstall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una operación anterior se detuvo a mitad de camino y dejó una copia de la app en los registros de Homebrew, así que Homebrew no puede desinstalarla. Forzar desinstalación elimina esa copia sobrante y completa la desinstalación."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущая операция прервалась и оставила копию приложения в записях Homebrew, поэтому Homebrew не может его удалить. «Force Uninstall» удалит оставшуюся копию и завершит удаление."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередня операція перервалася й залишила копію програми в записах Homebrew, тому Homebrew не може її видалити. «Force Uninstall» видалить залишкову копію та завершить видалення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前的操作中途停止，在 Homebrew 的记录中残留了该应用的副本，因此 Homebrew 无法将其卸载。「Force Uninstall」会清除残留副本并完成卸载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先前的操作中途停止，在 Homebrew 的記錄中殘留了該 App 的副本，因此 Homebrew 無法將其解除安裝。「Force Uninstall」會清除殘留副本並完成解除安裝。"
          }
        }
      }
    },
